[Unit]
Description=Ozon Worker
After=network.target postgresql.service

[Service]
Type=simple
WorkingDirectory=/opt/ozon_telegram_bot
ExecStart=/opt/ozon_telegram_bot/venv/bin/python -m scripts.run_worker
Restart=always
EnvironmentFile=/opt/ozon_telegram_bot/.env

[Install]
WantedBy=multi-user.target
